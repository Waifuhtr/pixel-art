# ── Local / free setup — these are now the code's built-in defaults too, ──
# ── this file is a REFERENCE, not something the container reads directly. ──
# HF Spaces does not load .env — set these under Space "Settings → Variables
# and secrets" only if you want to override a default (e.g. pick a bigger
# Ollama model, or switch back to Gemini). An empty/unset Space still runs
# fully local, because local_sd.py and entrypoint.sh default to these values.

# Concept-art reference image: run SD-Turbo GGUF on CPU instead of Gemini.
# Defaults to true in code (local_sd.py) — set to "false" to use Gemini instead.
# USE_LOCAL_SD=true
SD_GGUF_REPO=gpustack/stable-diffusion-v2-1-turbo-GGUF
SD_GGUF_FILE=stable-diffusion-v2-1-turbo-Q8_0.gguf
# SD_THREADS defaults to all CPU cores. SD_STEPS 1-4 is the SD-Turbo sweet spot.
# SD_THREADS=8
# SD_STEPS=4

# Pixel-painting agent: local Ollama model (started by entrypoint.sh in this image).
# Defaults to qwen2.5:3b in code (entrypoint.sh) if unset — small, real Ollama
# library model with tool-calling support, safe default for CPU-only hardware.
OLLAMA_URL=http://localhost:11434
# OLLAMA_MODELS=qwen2.5:3b
# Heavier but higher-quality alternatives (slower on CPU-only hardware):
# OLLAMA_MODELS=qwen3:8b
# OLLAMA_MODELS=llama3.1:8b

# ── Optional: switch back to hosted providers ──
# Setting either of these does NOT disable USE_LOCAL_SD automatically —
# unset USE_LOCAL_SD too if you want Gemini to generate reference images again.
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key

# ── Optional: API key auth for this Space (recommended if it's public) ──
# API_KEY=your_secret_key

# ── Optional: Redis for multi-worker scaling (not needed for a single Space) ──
# REDIS_URL=redis://localhost:6379

# ── Optional: S3-compatible object storage (not needed for a single Space) ──
# ENDPOINT=https://your-s3-endpoint
# ACCESS_KEY_ID=your_access_key
# SECRET_ACCESS_KEY=your_secret_key
# BUCKET=your_bucket_name

# ── Optional: tracing ──
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key
# POSTHOG_API_KEY=phc_your_project_api_key
